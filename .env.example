# DataCatalog AI - Environment Variables

# =============================================================================
# REQUIRED - Application will fail to start without these
# =============================================================================

# JWT Secret Key (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-minimum-32-chars-long

# =============================================================================
# OPTIONAL - Defaults provided
# =============================================================================

# Application
APP_NAME=DataCatalog AI
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# DATABASE - FEAT-002
# =============================================================================

# Database URL (required)
# PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/datacatalog
# SQLite (dev): sqlite+aiosqlite:///./data/app.db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Connection Pool Settings (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# =============================================================================
# VECTOR STORE & AI - FEAT-003
# =============================================================================

# OpenAI API Key (required for embeddings)
OPENAI_API_KEY=sk-your-openai-api-key

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=catalog

# =============================================================================
# FUTURE - Not used yet
# =============================================================================

# Azure Storage (FEAT-004+)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=datasets
